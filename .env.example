# ===========================================
# 🚀 Mavora Marketplace - Environment Variables
# ===========================================
# نسخ هذا الملف إلى .env وملأ القيم الحقيقية
# Copy this file to .env and fill in real values

# ============================================================
# 🔐 Supabase Configuration (Required)
# ============================================================
# من لوحة تحكم Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# 🌐 Application Configuration (Required)
# ============================================================
NEXT_PUBLIC_APP_URL=https://mavora.ma
NEXT_PUBLIC_APP_NAME=Mavora
NEXT_PUBLIC_APP_LOCALE=ar-MA

# Environment: development, staging, production
NODE_ENV=production

# ============================================================
# 💳 Payment Providers
# ============================================================

# --- Stripe (Optional) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal (Required for PayPal payments) ---
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Environment: sandbox (for testing) or live (for production)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_WEBHOOK_SECRET=your-webhook-secret

# --- Payoneer (Required for Payoneer payouts) ---
PAYONEER_API_KEY=your-payoneer-api-key
PAYONEER_API_SECRET=your-payoneer-api-secret
PAYONEER_PROGRAM_ID=your-program-id
PAYONEER_ENVIRONMENT=sandbox
PAYONEER_WEBHOOK_SECRET=your-webhook-secret

# --- Moroccan Payment Methods ---
MOROCCO_PAYMENT_CONFIG={}

# Active payment provider: stripe, paypal, payoneer, morocco
PAYMENT_PROVIDER=paypal

# ============================================================
# 📧 Email Service (Required for email features)
# ============================================================
# Using Resend (recommended)
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=noreply@mavora.ma
EMAIL_FROM_NAME=Mavora

# Or using SendGrid
# SENDGRID_API_KEY=SG.your-api-key-here

# Or using SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# ============================================================
# 📱 SMS Service (Required for 2FA SMS)
# ============================================================
# Using Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# 🔐 Two-Factor Authentication (2FA)
# ============================================================
# 2FA Issuer name (shown in authenticator apps)
TWO_FACTOR_ISSUER=Mavora

# Encryption key for 2FA secrets (generate with: openssl rand -base64 32)
TWO_FACTOR_ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ============================================================
# 📊 Analytics (Optional)
# ============================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# 🗄️ Redis/Cache (Optional - for production scaling)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ============================================================
# 📁 Storage (Supabase Storage or S3)
# ============================================================
# Supabase Storage Bucket Name
STORAGE_BUCKET_NAME=listings

# Or S3 (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=mavora-uploads

# ============================================================
# 🔔 Push Notifications (Optional)
# ============================================================
# Web Push (for browser notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@mavora.ma

# Firebase Cloud Messaging (optional)
# FCM_SERVER_KEY=your-fcm-server-key

# ============================================================
# 🌍 Localization (i18n)
# ============================================================
# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Supported locales
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en,fr

# ============================================================
# ⚡ Performance & Caching
# ============================================================
# Cache TTL in seconds
CACHE_TTL=300
# Enable CDN
NEXT_PUBLIC_CDN_URL=

# ============================================================
# 🛡️ Security
# ============================================================
# CORS Origins (comma-separated)
CORS_ORIGINS=https://mavora.ma,https://www.mavora.ma
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# CSRF Protection
CSRF_SECRET=your-csrf-secret-key-here

# ============================================================
# 📝 Logging
# ============================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
# External logging service (optional)
# DATADOG_API_KEY=your-datadog-key
# SENTRY_DSN=your-sentry-dsn

# ============================================================
# 🧪 Feature Flags (Optional)
# ============================================================
# Enable/disable features
ENABLE_REALTIME_NOTIFICATIONS=true
ENABLE_2FA=true
ENABLE_PROMOTIONS=true
ENABLE_ADVANCED_MAPS=true
ENABLE_PWA=true

# ============================================================
# 📱 Mobile App (React Native)
# ============================================================
# Deep link scheme
DEEP_LINK_SCHEME=mavora
# App Store URL
APP_STORE_URL=https://apps.apple.com/app/mavora
# Play Store URL
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ma.mavora.app

# ===========================================
# ⚠️  IMPORTANT SECURITY NOTES:
# ===========================================
#
# 1. NEVER commit your .env file to version control
# 2. Always use strong, unique secrets in production
# 3. Rotate keys/credentials regularly
# 4. Use different keys for each environment
# 5. Limit permissions of service role keys
# 6. Enable Row Level Security (RLS) in Supabase
# 7. Use HTTPS only in production
# 8. Set up proper CORS origins
# 9. Monitor logs for suspicious activity
# 10. Back up your database regularly
#
# ===========================================
# 📞 Support & Help
# ===========================================
# Documentation: https://docs.mavora.ma
# Support: support@mavora.ma
# Status: https://status.mavora.ma
