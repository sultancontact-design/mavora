# ===========================================
# Mavora Marketplace - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# -------------------------------------------
# Application Core
# -------------------------------------------
NEXT_PUBLIC_APP_NAME=Mavora
NEXT_PUBLIC_APP_URL=https://mavora.ma
NEXT_PUBLIC_APP_LOCALE=ar-MA
NEXT_PUBLIC_APP_CURRENCY=MAD
NEXT_PUBLIC_APP_TIMEZONE=Africa/Casablanca

# -------------------------------------------
# Supabase (Database & Auth)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# PayPal Integration (Sandbox/Production)
# -------------------------------------------
PAYPAL_MODE=sandbox  # Use 'sandbox' for testing, 'live' for production
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id-here

# PayPal Sandbox URLs (default, usually no need to change)
PAYPAL_SANDBOX_URL=https://api-m.sandbox.paypal.com
PAYPAL_LIVE_URL=https://api-m.paypal.com

# -------------------------------------------
# Payoneer Integration
# -------------------------------------------
PAYONEER_ENVIRONMENT=sandbox  # 'sandbox' or 'production'
PAYONEER_CLIENT_ID=your-payoneer-client-id
PAYONEER_CLIENT_SECRET=your-payoneer-client-secret
PAYONEER_PARTNER_ID=your-partner-id

# Payoneer API URLs
PAYONEER_SANDBOX_URL=https://api.sandbox.payoneer.com
PAYONEER_PRODUCTION_URL=https://api.payoneer.com

# -------------------------------------------
# Authentication & Security
# -------------------------------------------
# JWT Secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here-minimum-32-characters

# Two-Factor Authentication
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service (for 2FA and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@mavora.ma

# -------------------------------------------
# File Storage (Supabase Storage or S3)
# -------------------------------------------
STORAGE_PROVIDER=supabase  # 'supabase' or 's3'

# S3 Configuration (if using S3)
S3_BUCKET=mavora-uploads
S3_REGION=eu-west-3  # Paris (closest to Morocco)
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com

# -------------------------------------------
# Redis (for caching and sessions)
# -------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# -------------------------------------------
# Analytics & Monitoring
# -------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# -------------------------------------------
# SMS Gateway (Morocco)
#-------------------------------------------
SMS_PROVIDER=twilio  # 'twilio', 'infobip', or 'local'
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=https://api.infobip.com

# Local Moroccan SMS providers (alternative)
LOCAL_SMS_API_URL=https://sms.provider.ma/api
LOCAL_SMS_API_KEY=your-local-sms-api-key

# -------------------------------------------
# Payment Limits (MAD - Moroccan Dirham)
# -------------------------------------------
MAX_TRANSACTION_AMOUNT=50000
MIN_TRANSACTION_AMOUNT=1
DAILY_WITHDRAWAL_LIMIT=10000
MONTHLY_WITHDRAWAL_LIMIT=100000

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # per window per IP

# -------------------------------------------
# Feature Flags
# -------------------------------------------
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_OFFERS=true
NEXT_PUBLIC_ENABLE_SHIPPING_CALCULATOR=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# -------------------------------------------
# Social Login (Optional)
# -------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=com.mavora.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXX.p8

# -------------------------------------------
# Push Notifications (Firebase)
# -------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# -------------------------------------------
# Mapbox / Location Services
# -------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token

# -------------------------------------------
# Cloudinary (Image Optimization)
# -------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=mavora-uploads

# -------------------------------------------
# Admin / Superuser
# -------------------------------------------
ADMIN_EMAIL=admin@mavora.ma
ADMIN_USERNAME=admin

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=info  # 'debug', 'info', 'warn', 'error'
LOG_FORMAT=json  # 'json' or 'pretty'

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
ALLOWED_ORIGINS=https://mavora.ma,https://www.mavora.ma,http://localhost:3000

# -------------------------------------------
# Cookie Settings
# -------------------------------------------
COOKIE_DOMAIN=.mavora.ma
COOKIE_SECURE=true  # Set to false in development
COOKIE_SAME_SITE=lax
