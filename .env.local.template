# =============================================================================
# Mavora - Local Development Environment Template
# Arabic Marketplace Platform (Morocco)
# =============================================================================
# 
# Copy this file to .env.local and fill in your values:
#   cp .env.local.template .env.local
#
# ⚠️ Never commit .env.local to version control!
# ⚠️ This file contains sensitive information!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings / إعدادات التطبيق
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mavora
NEXT_PUBLIC_APP_DESCRIPTION=سوق عربي للمغرب - Arabic Marketplace for Morocco
NEXT_PUBLIC_APP_LOCALE=ar-MA
NEXT_PUBLIC_APP_CURRENCY=MAD
NEXT_PUBLIC_APP_DIRECTION=rtl
NEXT_PUBLIC_APP_TIMEZONE=Africa/Casablanca

# -----------------------------------------------------------------------------
# Supabase (Required) / سابايز (مطلوب)
# Get your credentials from: https://supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection / اتصال قاعدة البيانات
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Authentication / المصادقة
# -----------------------------------------------------------------------------
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# JWT Secret for custom tokens / مفتاح JWT
JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# 2FA / التحقق الثنائي (Optional)
# -----------------------------------------------------------------------------
ENABLE_2FA=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMS Provider / مزود الرسائل
SMS_PROVIDER=log # log | twilio | smsaero

# -----------------------------------------------------------------------------
# Email / البريد الإلكتروني (Optional for dev - logs to console)
# -----------------------------------------------------------------------------
# For development, leave empty and emails will be logged to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mavora.ma
EMAIL_REPLY_TO=support@mavora.ma

# -----------------------------------------------------------------------------
# Redis (Optional) / ريديس (اختياري)
# Used for caching, rate limiting, sessions
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# File Storage / تخزين الملفات
# -----------------------------------------------------------------------------
# Options: local | s3 | supabase | cloudinary
STORAGE_PROVIDER=local

# S3 (if using S3 storage)
S3_BUCKET=mavora-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary (if using Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Supabase Storage (if using Supabase)
SUPABASE_STORAGE_BUCKET=listings

# -----------------------------------------------------------------------------
# PayPal (Sandbox for development) / باي بال
# Get sandbox credentials from: https://developer.paypal.com/dashboard/applications
# -----------------------------------------------------------------------------
ENABLE_PAYPAL=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sb-your-sandbox-client-id
PAYPAL_CLIENT_SECRET=sb-your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id

# Payoneer / بايونير
ENABLE_PAYONEER=true
PAYONEER_API_URL=https://api.sandbox.payoneer.com
PAYONEER_USERNAME=
PAYONEER_PASSWORD=
PAYONEER_PARTNER_ID=

# Stripe (Alternative) / سترايب
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# -----------------------------------------------------------------------------
# Mapbox (for location features) / مابوكس
# -----------------------------------------------------------------------------
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Firebase (for push notifications) / فايربيس
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Analytics / التحليلات
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# -----------------------------------------------------------------------------
# Feature Flags / أعلام الميزات
# -----------------------------------------------------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_LISTINGS=true
ENABLE_MESSAGING=true
ENABLE_REVIEWS=true
ENABLE_FAVORITES=true
ENABLE_WALLET=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_PROMOTIONS=true
ENABLE_ORGANIZATIONS=true

# -----------------------------------------------------------------------------
# Rate Limiting / تحديد المعدل
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=50

# -----------------------------------------------------------------------------
# Cookie Settings / إعدادات الكوكيز
# -----------------------------------------------------------------------------
COOKIE_NAME=mavora-session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false # Set true in production with HTTPS
COOKIE_MAX_AGE=604800 # 7 days in seconds

# -----------------------------------------------------------------------------
# Development Settings / إعدادات التطوير
# -----------------------------------------------------------------------------
NODE_ENV=development
DEBUG=mavora:*
LOG_LEVEL=debug
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Social Login (Optional) / تسجيل الدخول الاجتماعي
# -----------------------------------------------------------------------------
# Google / جوجل
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook / فيسبوك
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple / آبل
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Admin Settings / إعدادات المشرف
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@mavora.ma
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# -----------------------------------------------------------------------------
# Testing / الاختبارات
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=$DATABASE_URL
TEST_REDIS_URL=$REDIS_URL

# =============================================================================
# Quick Start Guide / دليل البدء السريع
# =============================================================================
# 
# 1. Install dependencies:
#    npm install
#
# 2. Copy this template:
#    cp .env.local.template .env.local
#
# 3. Fill in required values (at minimum):
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SUPABASE_SERVICE_ROLE_KEY
#    - DATABASE_URL
#    - NEXTAUTH_SECRET
#
# 4. Run setup wizard (optional):
#    chmod +x scripts/setup.sh && ./scripts/setup.sh
#
# 5. Start development server:
#    npm run dev
#
# 6. Open browser:
#    http://localhost:3000
#
# =============================================================================
