// MAVORA Platform - Complete Database Schema
// Classified Ads Marketplace for Morocco & Global Markets

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String?
  image             String?
  passwordHash      String?
  phone             String?   @unique
  phoneVerified     Boolean   @default(false)
  role              String    @default("user") // user, verified_user, professional_seller, moderator, support_agent, finance_manager, content_manager, analyst, admin, super_admin
  isActive          Boolean   @default(true)
  isBanned          Boolean   @default(false)
  banReason         String?
  bannedAt          DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  profile           Profile?
  posts             Post[]
  listings          Listing[]
  favorites         Favorite[]
  savedSearches     SavedSearch[]
  conversationMembers ConversationMember[]
  messages          Message[]
  reports           Report[]
  reviewsGiven      Review[] @relation("ReviewAuthor")
  reviewsReceived   Review[] @relation("ReviewTarget")
  wallet            Wallet?
  subscriptions     Subscription[]
  orders            Order[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  verificationRequests VerificationRequest[]
  organizationMembers OrganizationMember[]
  moderationActions  ModerationAction[] @relation("Moderator")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl           String?
  bio                 String?
  dateOfBirth         DateTime?
  gender              String?  // male, female, other
  address             String?
  cityId              String?
  city                City?    @relation(fields: [cityId], references: [id])
  language            String   @default("ar") // ar, fr, en
  currency            String   @default("MAD")
  website             String?
  socialInstagram     String?
  socialFacebook      String?
  socialTwitter       String?
  isVerified          Boolean  @default(false)
  verifiedAt          DateTime?
  responseRate        Float?   // 0-100
  responseTime        Int?     // in hours
  rating              Float    @default(0)
  totalReviews        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("profiles")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model VerificationToken {
  token      String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires    DateTime
  type       String   // email_verification, password_reset, phone_verification
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

// ==================== ROLES & PERMISSIONS ====================

model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  permissions Permission[]
  userRoles   UserRole[]
  createdAt   DateTime    @default(now())

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  resource  String   // listing, user, payment, etc.
  action    String   // create, read, update, delete, moderate
  condition String?  // own, any, etc.
  roles     Role[]   
  createdAt DateTime @default(now())

  @@unique([resource, action, condition])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// ==================== ORGANIZATIONS ====================

model Organization {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  description       String?
  logoUrl           String?
  coverImageUrl     String?
  email             String
  phone             String?
  website           String?
  address           String?
  cityId            String?
  city              City?               @relation(fields: [cityId], references: [id])
  isVerified        Boolean             @default(false)
  verificationDoc   String?
  planId            String?
  plan              Plan?               @relation(fields: [planId], references: [id])
  subscription      Subscription?
  rating            Float               @default(0)
  totalReviews      Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  members           OrganizationMember[]
  listings          Listing[]
  reviewsReceived   Review[]            @relation("OrganizationReviews")

  @@index([slug])
  @@index([cityId])
  @@map("organizations")
}

model OrganizationMember {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String        @default("member") // owner, admin, member
  jobTitle        String?
  isActive        Boolean       @default(true)
  joinedAt        DateTime      @default(now())

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ==================== GEOGRAPHY ====================

model Country {
  id            String    @id @default(cuid())
  name          String
  nameAr        String?
  nameFr        String?
  code          String    @unique // ISO 3166-1 alpha-2
  flagEmoji     String?
  phoneCode    String?
  currencyCode String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  regions       Region[]
  cities        City[]
  
  @@index([code])
  @@map("countries")
}

model Region {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  nameFr    String?
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  cities    City[]
  createdAt DateTime @default(now())

  @@index([countryId])
  @@map("regions")
}

model City {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  nameFr    String?
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])
  latitude  Float?
  longitude Float?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  
  profiles  Profile[]
  organizations Organization[]
  listings  Listing[]
  createdAt DateTime @default(now())

  @@index([countryId])
  @@index([regionId])
  @@map("cities")
}

model Currency {
  id          String   @id @default(cuid())
  code        String   @unique // MAD, USD, EUR
  name        String
  symbol      String
  nameAr      String?
  decimalPlaces Int    @default(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("currencies")
}

// ==================== CATEGORIES ====================

model Category {
  id          String          @id @default(cuid())
  name        String
  nameAr      String?
  nameFr      String?
  slug        String          @unique
  description String?
  icon        String?         // icon name or URL
  parentId    String?
  parent      Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryTree")
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  
  fields      CategoryField[]
  listings    Listing[]
  seoPage     SeoPage?

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model CategoryField {
  id            String              @id @default(cuid())
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  nameFr        String?
  type          String              // text, number, select, multiselect, boolean, date, url
  placeholder   String?
  options       CategoryFieldOption[]
  required      Boolean             @default(false)
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)

  values        ListingFieldValue[]

  @@index([categoryId])
  @@map("category_fields")
}

model CategoryFieldOption {
  id             String        @id @default(cuid())
  fieldId        String
  field          CategoryField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value          String
  valueAr        String?
  valueFr        String?
  sortOrder      Int           @default(0)

  @@index([fieldId])
  @@map("category_field_options")
}

// ==================== LISTINGS (CORE) ====================

model Listing {
  id                String                @id @default(cuid())
  title             String
  description       String?                @db.Text
  price             Decimal?               @db.Decimal(12, 2)
  negotiable        Boolean               @default(false)
  currencyCode      String                @default("MAD")
  condition         String?               // new, used, like_new, refurbished
  status            String                @default("draft") // draft, pending_review, active, sold, reserved, expired, rejected, archived
  featuredUntil     DateTime?
  promotedUntil     DateTime?
  urgentUntil       DateTime?
  viewCount         Int                   @default(0)
  contactPhone      String?
  contactEmail      String?
  locationAddress   String?
  locationLat       Float?
  locationLng       Float?
  cityId            String?
  city              City?                 @relation(fields: [cityId], references: [id])
  countryId         String?
  country           Country?              @relation(fields: [countryId], references: [id])
  categoryId        String
  category          Category              @relation(fields: [categoryId], references: [id])
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization?          @relation(fields: [organizationId], references: [id])
  videoUrl          String?
  externalLink      String?
  rejectionReason   String?
  moderatedAt       DateTime?
  moderatedBy       String?
  publishedAt       DateTime?
  expiresAt         DateTime?
  soldAt            DateTime?
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  fieldValues       ListingFieldValue[]
  media             ListingMedia[]
  locations         ListingLocation[]
  statusHistory     ListingStatusHistory[]
  favorites         Favorite[]
  reviews           Review[]              @relation("ListingReviews")
  promotions        ListingPromotion[]
  reports           Report[]

  @@index([status])
  @@index([categoryId])
  @@index([userId])
  @@index([cityId])
  @@index([price])
  @@index([createdAt])
  @@index([featuredUntil])
  @@fulltext([title, description])
  @@map("listings")
}

model ListingFieldValue {
  id        String        @id @default(cuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CategoryField @relation(fields: [fieldId], references: [id])
  value     String        @db.Text
  valueJson Json?

  @@unique([listingId, fieldId])
  @@index([listingId])
  @@map("listing_field_values")
}

model ListingMedia {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  type        String   @default("image") // image, video
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  altText     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@map("listing_media")
}

model ListingLocation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  label     String   // e.g., "Meeting point", "Store location"
  address   String
  latitude  Float
  longitude Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_locations")
}

model ListingStatusHistory {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus  String
  reason    String?
  changedBy String?
  changedAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_status_history")
}

// ==================== FAVORITES & SAVED SEARCHES ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
  @@map("favorites")
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     Json     // stored search filters
  alertFrequency String? // instant, daily, weekly
  lastSentAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_searches")
}

// ==================== MESSAGING ====================

model Conversation {
  id          String   @id @default(cuid())
  subject     String?
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  lastMessageAt DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ConversationMember[]
  messages    Message[]

  @@index([listingId])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  leftAt         DateTime?
  createdAt      DateTime      @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?      @db.Text
  messageType    String       @default("text") // text, image, system
  mediaUrl       String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ==================== MODERATION & REPORTS ====================

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String   // listing, user, message, conversation
  targetId    String
  reason      String   // spam, inappropriate, scam, duplicate, etc.
  description String?  @db.Text
  status      String   @default("pending") // pending, reviewed, resolved, dismissed
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing?  @relation(fields: [targetId], references: [id])
  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetType  String   // listing, user, organization
  targetId    String
  listing     Listing?  @relation("ListingReviews", fields: [targetId], references: [id])
  targetUser  User?     @relation("ReviewTarget", fields: [targetId], references: [id])
  organization Organization? @relation("OrganizationReviews", fields: [targetId], references: [id])
  rating      Int      // 1-5
  title       String?
  content     String?  @db.Text
  response    String?  @db.Text
  respondedAt DateTime?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([authorId])
  @@map("reviews")
}

model ModerationAction {
  id          String   @id @default(cuid())
  targetType  String   // listing, user, conversation
  targetId    String
  actionType  String   // ban, suspend, hide, warn, delete
  reason      String?  @db.Text
  moderatorId String
  moderator   User     @relation("Moderator", fields: [moderatorId], references: [id])
  duration    Int?     // in hours, null = permanent
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

model VerificationRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // identity, business, phone, email
  status      String   @default("pending") // pending, approved, rejected
  documents   String[] // URLs of uploaded documents
  metadata    Json?
  reviewedBy  String?
  reviewedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

// ==================== SUBSCRIPTIONS & PLANS ====================

model Plan {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  nameFr      String?
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  durationDays Int
  features    Json    // list of features included
  maxListings Int?     // null = unlimited
  maxImagesPerListing Int @default(10)
  canPromote  Boolean  @default(false)
  hasAnalytics Boolean  @default(false)
  hasCustomBranding Boolean @default(false)
  prioritySupport Boolean @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String       @id @default(cuid())
  planId          String
  plan            Plan         @relation(fields: [planId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  status          String       @default("active") // active, paused, cancelled, expired
  startDate       DateTime
  endDate         DateTime?
  autoRenew       Boolean      @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

// ==================== PAYMENTS & WALLET ====================

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("MAD")
  frozenBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // credit, debit, freeze, unfund
  amount      Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal @db.Decimal(12, 2)
  description String?
  referenceType String? // purchase, refund, promotion, bonus, withdrawal
  referenceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model TokenPackage {
  id          String   @id @default(cuid())
  name        String
  tokens      Int
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  bonusTokens Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("token_packages")
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String       @default("pending") // pending, paid, failed, refunded, cancelled
  subtotal        Decimal      @db.Decimal(12, 2)
  tax             Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  currency        String       @default("MAD")
  paymentMethod   String?      // stripe, paypal, bank_transfer, morocco_payment
  paymentId       String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payments        Payment[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType    String   // token_package, promotion, subscription
  itemId      String
  itemName    String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.DecimalField(12, 2)
  metadata    Json?

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   // stripe, paypal, morocco_payment, bank_transfer
  providerPaymentId String?
  status          String   @default("pending") // pending, processing, completed, failed, refunded, disputed
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("MAD")
  fee             Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  metadata        Json?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          PaymentEvent[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType   String   // created, authorized, captured, refunded, failed, disputed
  eventData   Json?
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

// ==================== PROMOTIONS ====================

model Promotion {
  id          String   @id @default(cuid())
  name        String
  type        String   // bump, feature, urgent, homepage, highlight
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  durationHours Int
  maxDurationHours Int?
  isActive    Boolean  @default(true)
  constraints Json?   // category-specific pricing, etc.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    ListingPromotion[]

  @@map("promotions")
}

model ListingPromotion {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  status      String   @default("active") // active, paused, expired, cancelled
  startedAt   DateTime
  expiresAt   DateTime
  pricePaid   Decimal  @db.Decimal(10, 2)
  currency    String   @default("MAD")
  orderId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([promotionId])
  @@map("listing_promotions")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // new_message, listing_viewed, favorite_added, promotion_expiring, etc.
  title       String
  body        String?  @db.Text
  data        Json?    // related resource IDs
  isRead      Boolean  @default(false)
  readAt      DateTime?
  sentVia     String[] // in_app, email, push
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  newMessage  Boolean  @default(true)
  listingViewed Boolean @default(false)
  favoriteAdded Boolean @default(true)
  promotionExpiring Boolean @default(true)
  priceDrop   Boolean  @default(true)
  newReview   Boolean  @default(true)
  marketing   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_preferences")
}

// ==================== SYSTEM & AUDIT ====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // create, update, delete, login, logout, etc.
  resourceType String  // user, listing, order, etc.
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // page_view, listing_click, search, etc.
  sessionId   String?
  userId      String?
  data        Json?
  ipAddress   String?
  userAgent   String?
  referrer    String?
  url         String?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}

model BannedTerm {
  id          String   @id @default(cuid())
  term        String   @unique
  category    String   // spam, inappropriate, scam, etc.
  isActive    Boolean  @default(true)
  addedBy     String?
  createdAt   DateTime @default(now())

  @@map("banned_terms")
}

model FraudSignal {
  id          String   @id @default(cuid())
  userId      String?
  signalType  String   // rapid_posting, duplicate_content, suspicious_ip, etc.
  severity    String   // low, medium, high, critical
  data        Json?
  isResolved  Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([signalType])
  @@index([isResolved])
  @@map("fraud_signals")
}

// ==================== SEO & CONTENT ====================

model SeoPage {
  id          String   @id @default(cuid())
  pageType    String   // category, city, search
  entityId    String   // category ID or city ID
  slug        String   @unique
  title       String
  description String?  @db.Text
  keywords    String[]
  heading     String?
  content     String?  @db.Text
  schemaMarkup Json?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_pages")
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String?
  subject     String
  description String?  @db.Text
  status      String   @default("open") // open, in_progress, waiting, resolved, closed
  priority    String   @default("medium") // low, medium, high, urgent
  category    String?  // technical, billing, content, other
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// ==================== LEGACY/TEMPORARY (for migration) ====================

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}
