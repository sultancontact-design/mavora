// Prisma Schema - آمن ومحسن
// آخر تحديث: 2026-09-03
// المراجعة الأمنية: مكتملة

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// نموذج المستخدم مع حماية البيانات
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // user, admin, moderator
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // علاقة واحدة مع المنشورات
  posts     Post[]
  
  @@index([email])
  @@index([role])
}

// نموذج المنشور مع العلاقات الصحيحة والأمان
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // علاقة مع المستخدم - إلزامية
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([authorId])
  @@index([published])
  @@index([createdAt])
}
